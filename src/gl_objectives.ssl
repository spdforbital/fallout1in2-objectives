variable iniFile := "mods\\fo1_objectives\\objectives.ini";
variable begin
   loaded;
   // settings
   panelOn; panelW; panelX; panelY; optCount; stepCount; showDone; panelBg; hideHover;
   panelFont; showGear; showTimer; panelInCombat; refreshFrames;
   hlOn; hlQuest; hlGear; hlCont; hlQuestCol; hlGearCol; gearMargin;
   tabKey; panelKey;
   // runtime
   frame; qStatus; qCur; mvarMem; trackedKey;
   panelLines; panelSig; panelVisible; panelH; panelCreated; lineH;
   gearList; gearCurW; gearCurA; ammoCal; guidePid; guideTile;
   outlined; questPids;
   tabOpen; tabPage; tabRows; tabSel; tabTop; tabCreated; tabX; tabY; tabW; tabH;
   showFinished; keyCapture; setNames; panelExists;
   hlKey; hlDirty; owned; questsAll;
   onWorld; infoArrow; infoTgt; doneMem; marks; markWin; markOn; markOutline; markEdge; markCol; ownsScenery;
end

/* ------------------------------------------------------------------ settings */

procedure IniInt(variable sect, variable key, variable def) begin
   variable v := get_ini_setting(iniFile + "|" + sect + "|" + key);
   if (v == -1) then return def;
   return v;
end

procedure SaveSetting(variable sect, variable key, variable val) begin
   set_ini_setting(iniFile + "|" + sect + "|" + key, val);
end

procedure LoadSettings begin
   panelOn       := IniInt("Panel", "Enabled", 1);
   panelW        := IniInt("Panel", "Width", 300);
   panelX        := IniInt("Panel", "X", -1);
   panelY        := IniInt("Panel", "Y", 6);
   optCount      := IniInt("Panel", "OptionalQuests", 3);
   stepCount     := IniInt("Panel", "StepsPerQuest", 2);
   showDone      := IniInt("Panel", "ShowDoneStep", 1);
   panelBg       := IniInt("Panel", "Background", 1);
   hideHover     := IniInt("Panel", "HideOnHover", 1);
   panelFont     := IniInt("Panel", "Font", 101);
   showGear      := IniInt("Panel", "ShowGear", 1);
   showTimer     := IniInt("Panel", "ShowTimer", 1);
   panelInCombat := IniInt("Panel", "ShowInCombat", 1);
   refreshFrames := IniInt("Panel", "RefreshFrames", 15);
   hlOn          := IniInt("Highlight", "Enabled", 1);
   hlQuest       := IniInt("Highlight", "QuestItems", 1);
   hlGear        := IniInt("Highlight", "BetterGear", 1);
   hlCont        := IniInt("Highlight", "Containers", 0);
   hlQuestCol    := IniInt("Highlight", "QuestColor", OUTLINE_YELLOW);
   hlGearCol     := IniInt("Highlight", "GearColor", OUTLINE_GREEN_GLOW);
   gearMargin    := IniInt("Highlight", "BetterByPercent", 10);
   tabKey        := IniInt("Keys", "Objectives", DIK_O);
   panelKey      := IniInt("Keys", "TogglePanel", 0);
   questsAll     := IniInt("Tab", "AllQuests", 1);
   markOutline   := IniInt("Markers", "OutlineTargets", 1);
   markEdge      := IniInt("Markers", "EdgeArrows", 1);
   markCol       := IniInt("Markers", "TargetColor", OUTLINE_PURPLE);
   // key of the built-in highlighter (sfall gl_highlighting, mods\sfall-mods.ini)
   hlKey := get_ini_setting("mods\\sfall-mods.ini|Highlighting|Key");
   if (hlKey <= 0) then hlKey := DIK_LCONTROL;
   if (panelW < 160) then panelW := 160;
   if (refreshFrames < 1) then refreshFrames := 1;
   if (stepCount < 1) then stepCount := 1;
   if (panelFont < 100 or panelFont > 103) then panelFont := 101;
   lineH := 12;
   if (panelFont == 100) then lineH := 10;
end

/* ---------------------------------------------------------------- conditions */

procedure CmpOp(variable v, variable op, variable c) begin
   if (op == 1) then return v == c;
   if (op == 2) then return v != c;
   if (op == 3) then return v >= c;
   if (op == 4) then return v <= c;
   if (op == 5) then return v > c;
   if (op == 6) then return v < c;
   return false;
end

// Condition = OR of AND groups. c_pool[off] = atom count, then 5 ints per atom.
procedure EvalCond(variable off) begin
   variable n := c_pool[off], i := 0, p, t, v, grp := true, key;
   while (i < n) do begin
      p := off + 1 + i * 5;
      t := c_pool[p];
      if (t == C_OR) then begin
         if (grp) then return true;
         grp := true;
      end else if (grp) then begin
         if (t == C_GVAR) then begin
            grp := CmpOp(global_var(c_pool[p + 1]), c_pool[p + 3], c_pool[p + 4]);
         end else if (t == C_ITEM) then begin
            grp := CmpOp(obj_is_carrying_obj_pid(dude_obj, c_pool[p + 1]), c_pool[p + 3], c_pool[p + 4]);
         end else if (t == C_MAP) then begin
            grp := (cur_map_index == c_pool[p + 1]);
         end else if (t == C_MVAR) then begin
            key := c_pool[p + 1] * 1000 + c_pool[p + 2];
            if (cur_map_index == c_pool[p + 1]) then begin
               v := map_var(c_pool[p + 2]);
               mvarMem[key] := v;
            end else begin
               v := mvarMem[key];
            end
            grp := CmpOp(v, c_pool[p + 3], c_pool[p + 4]);
         end else if (t == C_TOWN) then begin
            grp := CmpOp(town_known(c_pool[p + 1]), c_pool[p + 3], c_pool[p + 4]);
         end else if (t == C_PARTY) then begin
            v := 0;
            if (party_member_obj(c_pool[p + 1])) then v := 1;
            grp := CmpOp(v, c_pool[p + 3], c_pool[p + 4]);
         end else if (t == C_TRUE) then begin
            grp := true;
         end else begin
            grp := false;
         end
      end
      i += 1;
   end
   return grp;
end

// remember map variables used by conditions while we are on their map
procedure UpdateMvars begin
   variable s, q;
   for (q := 0; q < OBJ_NQ; q++) begin
      call EvalCond(q_active[q]);
   end
end

// Done quests and steps stay done (remembered in the savegame, array "obj_done"), so a
// condition that later goes back (companion told to wait, left a map...) does not un-tick.
// Repeatable jobs (caravans) are not remembered.
procedure QuestStatus(variable q) begin
   variable key := "q" + q_key[q];
   if (doneMem[key]) then return QS_DONE;
   if (EvalCond(q_fail[q])) then return QS_FAILED;
   if (EvalCond(q_done[q])) then begin
      if (not q_rep[q]) then doneMem[key] := 1;
      return QS_DONE;
   end
   if (EvalCond(q_active[q])) then return QS_ACTIVE;
   if (EvalCond(q_unlock[q])) then return QS_INACTIVE;   // can be started
   return QS_LOCKED;
end

procedure StepDone(variable s) begin
   variable q := s_q[s], key;
   key := "s" + q_key[q] + "_" + (s - q_s0[q]);
   if (doneMem[key]) then return true;
   if (EvalCond(s_done[s])) then begin
      if (not q_rep[q]) then doneMem[key] := 1;
      return true;
   end
   return false;
end

procedure StepApplies(variable s) begin
   return EvalCond(s_show[s]);
end

// steps marked 'alt' are alternatives to the step before: a group is done when any member is
procedure GroupStart(variable s) begin
   while (s > 0 and s_alt[s]) do s -= 1;
   return s;
end

procedure GroupDone(variable s) begin
   variable k := GroupStart(s);
   if (StepApplies(k) and StepDone(k)) then return true;
   k += 1;
   while (k < OBJ_NS and s_alt[k]) do begin
      if (StepApplies(k) and StepDone(k)) then return true;
      k += 1;
   end
   return false;
end

// tab sections: -2 main quest, -1 companions, 0.. towns (other optional quests)
procedure InSection(variable q, variable t) begin
   if (t == -2) then return q_main[q];
   if (t == -1) then return q_comp[q];
   return (not q_main[q] and not q_comp[q] and q_town[q] == t);
end

procedure SectionName(variable t) begin
   if (t == -2) then return "MAIN QUEST";
   if (t == -1) then return "COMPANIONS";
   return town_name[t];
end

// 2 = on this map and elevation, 1 = this map other elevation, 0 = elsewhere, -1 = anywhere
procedure StepOnMap(variable s) begin
   variable i, w, best := 0;
   if (s_wn[s] == 0) then return -1;
   if (onWorld) then return 0;
   for (i := 0; i < s_wn[s]; i++) begin
      w := i_pool[s_w0[s] + i];
      if ((w / 8) == cur_map_index) then begin
         if ((w % 8) == 0 or (w % 8) - 1 == elevation(dude_obj)) then return 2;
         best := 1;
      end
   end
   return best;
end

// returns [tile, elev] of the nearest target on this map, or 0
procedure StepTarget(variable s) begin
   variable k := s_tkind[s], i, o, v, best := -1, bestT := -1, bestE := 0, d, list, t, e, h, bestO := 0;
   if (k == T_NONE or s_tn[s] == 0) then return 0;
   if (k == T_TILE) then begin
      for (i := 0; i < s_tn[s]; i++) begin
         v := i_pool[s_t0[s] + i];
         t := v / 4;
         e := (v % 4) - 1;
         if (e < 0) then e := elevation(dude_obj);
         d := tile_distance(tile_num(dude_obj), t);
         if (e != elevation(dude_obj)) then d += 10000;
         if (best < 0 or d < best) then begin best := d; bestT := t; bestE := e; end
      end
   end else begin
      if (k == T_NPC or k == T_CRITTER) then list := list_as_array(LIST_CRITTERS);
      else if (k == T_ITEM) then list := list_as_array(LIST_GROUNDITEMS);
      else list := list_as_array(LIST_SCENERY);
      foreach (o in list) begin
         if (o and o != dude_obj) then begin
            h := 0;
            for (i := 0; i < s_tn[s]; i++) begin
               v := i_pool[s_t0[s] + i];
               if (k == T_NPC) then begin
                  if (get_script(o) == v) then h := o;
               end else if (obj_pid(o) == v) then begin
                  h := o;
               end else if (k == T_ITEM) then begin
                  if (obj_item_subtype(o) == item_type_container) then begin
                     if (obj_is_carrying_obj_pid(o, v)) then h := o;
                  end
               end
            end
            if (h) then begin
               d := tile_distance_objs(dude_obj, h);
               if (elevation(h) != elevation(dude_obj)) then d += 10000;
               if (best < 0 or d < best) then begin
                  best := d; bestT := tile_num(h); bestE := elevation(h); bestO := h;
               end
            end
         end
      end
      // items carried by critters (e.g. on a body)
      if (k == T_ITEM and bestT < 0) then begin
         foreach (o in list_as_array(LIST_CRITTERS)) begin
            if (o and o != dude_obj) then begin
               for (i := 0; i < s_tn[s]; i++) begin
                  if (obj_is_carrying_obj_pid(o, i_pool[s_t0[s] + i])) then begin
                     d := tile_distance_objs(dude_obj, o);
                     if (elevation(o) != elevation(dude_obj)) then d += 10000;
                     if (best < 0 or d < best) then begin
                        best := d; bestT := tile_num(o); bestE := elevation(o); bestO := o;
                     end
                  end
               end
            end
         end
      end
   end
   if (bestT < 0) then return 0;
   return [bestT, bestE, bestO];
end

procedure DirName(variable rot) begin
   if (rot == 0) then return "NE";
   if (rot == 1) then return "E";
   if (rot == 2) then return "SE";
   if (rot == 3) then return "SW";
   if (rot == 4) then return "W";
   return "NW";
end

// screen offset in pixels between two hexes on the same level (walks the hex line; 6 neighbour
// vectors: NE (16,-12), E (32,0), SE (16,12), SW (-16,12), W (-32,0), NW (-16,-12))
procedure ScreenOffset(variable fromTile, variable toTile) begin
   variable cur := fromTile, r, dx := 0, dy := 0, n := 0;
   while (cur != toTile and n < 400) do begin
      r := rotation_to_tile(cur, toTile);
      if (r == 0) then begin dx += 16; dy -= 12; end
      else if (r == 1) then dx += 32;
      else if (r == 2) then begin dx += 16; dy += 12; end
      else if (r == 3) then begin dx -= 16; dy += 12; end
      else if (r == 4) then dx -= 32;
      else begin dx -= 16; dy -= 12; end
      cur := tile_num_in_direction(cur, r, 1);
      n += 1;
   end
   return [dx, dy];
end

// 0 N, 1 NE, 2 E, 3 SE, 4 S, 5 SW, 6 W, 7 NW (screen directions)
procedure ArrowFor(variable dx, variable dy) begin
   variable ax := dx, ay := dy;
   if (ax < 0) then ax := -ax;
   if (ay < 0) then ay := -ay;
   if (ax * 100 > ay * 241) then begin
      if (dx > 0) then return 2; return 6;
   end
   if (ay * 100 > ax * 241) then begin
      if (dy < 0) then return 0; return 4;
   end
   if (dy < 0) then begin
      if (dx > 0) then return 1; return 7;
   end
   if (dx > 0) then return 3;
   return 5;
end

// our own arrows (tools/make_arrows.py): OBJA = 13 px for the panel, OBJM = 17 px for markers
procedure ArrowFile(variable a) begin
   return "art\\intrface\\OBJA" + a + ".FRM";
end

// "Junktown 9sq SE" style text from the world map position to a town
procedure WorldDir(variable town) begin
   variable dx, dy, ax, ay, d, dir := "";
   if (town < 0) then return "";
   dx := town_x[town] - get_world_map_x_pos;
   dy := town_y[town] - get_world_map_y_pos;
   if (onWorld and (dx != 0 or dy != 0)) then infoArrow := ArrowFor(dx, dy);
   ax := dx; if (ax < 0) then ax := -ax;
   ay := dy; if (ay < 0) then ay := -ay;
   d := ax; if (ay > d) then d := ay;
   d := (d + 25) / 50;
   if (d == 0) then return "";
   if (ay * 2 > ax) then begin
      if (dy < 0) then dir := "N"; else dir := "S";
   end
   if (ax * 2 > ay) then begin
      if (dx < 0) then dir += "W"; else dir += "E";
   end
   return d + "sq " + dir;
end

procedure CountAlive(variable s) begin
   variable o, i, n := 0;
   if (s_kn[s] == 0) then return -1;
   foreach (o in list_as_array(LIST_CRITTERS)) begin
      if (o and critter_state(o) != CRITTER_IS_DEAD) then begin
         for (i := 0; i < s_kn[s]; i++) begin
            if (obj_pid(o) == i_pool[s_k0[s] + i]) then n += 1;
         end
      end
   end
   return n;
end

// right-hand info text for a step
procedure StepInfo(variable s) begin
   variable on := StepOnMap(s), tgt, d, info := "", n, w, town, lab, off;
   infoArrow := -1;
   infoTgt := 0;
   if (on == -1) then return "";
   if (on >= 1) then begin
      tgt := StepTarget(s);
      if (tgt) then begin
         infoTgt := tgt;
         if (tgt[1] != elevation(dude_obj)) then begin
            info := "go to level " + (tgt[1] + 1);
         end else begin
            d := tile_distance(tile_num(dude_obj), tgt[0]);
            if (d <= 1) then info := "here";
            else begin
               off := ScreenOffset(tile_num(dude_obj), tgt[0]);
               infoArrow := ArrowFor(off[0], off[1]);
               info := d + " hex";
            end
         end
      end else if (on == 1) then begin
         info := "other level";
      end else begin
         info := "on this map";
      end
      n := CountAlive(s);
      if (n >= 0) then info += " (" + n + " left)";
      return info;
   end
   // elsewhere: go to the first listed map
   w := i_pool[s_w0[s]] / 8;
   town := -1;
   if (w >= 0 and w < OBJ_NMAPS) then town := map_town[w];
   lab := s_label[s];
   if (town >= 0 and not onWorld and cur_map_index >= 0 and cur_map_index < OBJ_NMAPS) then begin
      if (map_town[cur_map_index] == town) then return "go: " + lab;
   end
   info := WorldDir(town);
   if (info != "") then return "go: " + lab + " " + info;
   return "go: " + lab;
end

/* -------------------------------------------------------------- quest state */

procedure ComputeStatus begin
   variable q, s, i, first;
   for (q := 0; q < OBJ_NQ; q++) begin
      qStatus[q] := QuestStatus(q);
      first := -1;
      if (qStatus[q] == QS_ACTIVE) then begin
         for (i := 0; i < q_sn[q]; i++) begin
            s := q_s0[q] + i;
            if (first < 0 and StepApplies(s) and not GroupDone(s)) then first := s;
         end
      end
      qCur[q] := first;
   end
end

/* -------------------------------------------------------------------- panel */

procedure PanelAdd(variable txt, variable info, variable col, variable indent) begin
   variable n := len_array(panelLines);
   resize_array(panelLines, n + 5);
   panelLines[n] := txt;
   panelLines[n + 1] := info;
   panelLines[n + 2] := col;
   panelLines[n + 3] := indent;
   panelLines[n + 4] := -1;
end

// arrow for the line just added, and remember its target for the map markers
procedure PanelArrow begin
   variable n := len_array(panelLines);
   if (n >= 5) then panelLines[n - 1] := infoArrow;
   if (infoTgt) then call AddMark(infoTgt, 0);
end

procedure PanelAddQuest(variable q, variable withTown) begin
   variable i, s, shown := 0, lastDone := -1, title := q_name[q], grp, lastGrp := -1;
   if (withTown) then title := town_name[q_town[q]] + ": " + title;
   if (q_key[q] == trackedKey) then title := "* " + title;
   call PanelAdd(title, "", COL_HEAD, 6);
   for (i := 0; i < q_sn[q]; i++) begin
      s := q_s0[q] + i;
      if (StepApplies(s)) then begin
         grp := GroupStart(s);
         if (StepDone(s)) then begin
            lastDone := s;
         end else if (not GroupDone(s)) then begin
            if (grp == lastGrp and s_alt[s]) then begin
               // another way to do the step just shown
               call PanelAdd("  or: " + s_text[s], StepInfo(s), COL_TEXT, 12);
               call PanelArrow;
            end else if (shown < stepCount) then begin
               if (shown == 0 and lastDone >= 0 and showDone) then
                  call PanelAdd("X " + s_text[lastDone], "", COL_DONE, 12);
               call PanelAdd("- " + s_text[s], StepInfo(s), COL_TEXT, 12);
               call PanelArrow;
               shown += 1;
               lastGrp := grp;
            end
         end
      end
   end
end

procedure WaterLine begin
   variable days;
   if (not showTimer) then return "";
   if (global_var(GVAR_VAULT_WATER) < 2) then begin
      if (global_var(GVAR_VAULT13_WATER_DAYS) <= 0) then return "";
      days := global_var(GVAR_VAULT13_WATER_DAYS) - (game_time / TICKS_PER_DAY
              - global_var(GVAR_VAULT13_WATER_DAYS_COUNTER) / TICKS_PER_DAY);
      return "Water: " + days + " days";
   end
   if (global_var(GVAR_VAULT_13_WAS_INVADED) == 0 and global_var(GVAR_VAULT_13_INVASION_DAYS) > 0
       and (global_var(GVAR_MASTER_BLOWN_CUTSCENE) == 0 or global_var(GVAR_VATS_BLOWN_CUTSCENE_DONE) == 0)) then begin
      days := global_var(GVAR_VAULT_13_INVASION_DAYS) - (game_time / TICKS_PER_DAY
              - global_var(GVAR_VAULT13_WATER_DAYS_COUNTER) / TICKS_PER_DAY);
      // with delayed invasions Fo1in2 parks the timer at a huge value until the Watershed visit
      if (days > 2000) then return "";
      return "Invasion: ~" + days + " days";
   end
   return "";
end

procedure BuildPanel begin
   variable q, s, n := 0, mainShown := false, curTown := -1, cand, score, i, j, tmp, best, g, info, w;
   panelLines := temp_array(0, 0);
   if (marks) then clear_array(marks);
   if (not onWorld and cur_map_index >= 0 and cur_map_index < OBJ_NMAPS) then curTown := map_town[cur_map_index];
   // main quest
   for (q := 0; q < OBJ_NQ; q++) begin
      if (q_main[q] and qStatus[q] == QS_ACTIVE) then begin
         if (not mainShown) then begin
            call PanelAdd("MAIN QUEST", WaterLine, COL_INFO, 0);
            mainShown := true;
         end
         call PanelAddQuest(q, false);
      end
   end
   if (not mainShown) then begin
      info := WaterLine;
      if (info != "") then call PanelAdd("MAIN QUEST", info, COL_INFO, 0);
   end
   // optional quests: tracked, then here, then same town, then nearest town
   if (optCount > 0) then begin
      cand := temp_array(0, 0);
      for (q := 0; q < OBJ_NQ; q++) begin
         if (not q_main[q] and qStatus[q] == QS_ACTIVE) then begin
            score := 1000;
            if (q_key[q] == trackedKey) then score := 0;
            else if (q_comp[q]) then begin
               // companions only show up in the panel in their own town (or when tracked)
               if (q_town[q] == curTown) then score := 250; else score := -1;
            end else begin
               s := qCur[q];
               if (s >= 0 and StepOnMap(s) >= 1) then score := 100;
               else if (q_town[q] == curTown) then score := 200;
               else if (onWorld) then begin
                  tmp := town_x[q_town[q]] - get_world_map_x_pos;
                  if (tmp < 0) then tmp := -tmp;
                  j := town_y[q_town[q]] - get_world_map_y_pos;
                  if (j < 0) then j := -j;
                  score := 300 + (tmp + j) / 50;
               end else if (curTown >= 0) then begin
                  tmp := town_x[q_town[q]] - town_x[curTown];
                  if (tmp < 0) then tmp := -tmp;
                  j := town_y[q_town[q]] - town_y[curTown];
                  if (j < 0) then j := -j;
                  score := 300 + (tmp + j) / 50;
               end
            end
            if (score >= 0) then begin
               n := len_array(cand);
               resize_array(cand, n + 2);
               cand[n] := score;
               cand[n + 1] := q;
            end
         end
      end
      // selection sort of the first optCount candidates
      n := len_array(cand) / 2;
      j := 0;
      if (n > 0) then call PanelAdd("OPTIONAL", "", COL_INFO, 0);
      while (j < n and j < optCount) do begin
         best := j;
         for (i := j + 1; i < n; i++) begin
            if (cand[i * 2] < cand[best * 2]) then best := i;
         end
         tmp := cand[j * 2]; cand[j * 2] := cand[best * 2]; cand[best * 2] := tmp;
         tmp := cand[j * 2 + 1]; cand[j * 2 + 1] := cand[best * 2 + 1]; cand[best * 2 + 1] := tmp;
         call PanelAddQuest(cand[j * 2 + 1], q_town[cand[j * 2 + 1]] != curTown);
         j += 1;
      end
   end
   // gear
   if (showGear and not onWorld and len_array(gearList) > 0) then begin
      g := -1;
      for (i := 0; i < len_array(gearList); i += 6) begin
         if (guidePid and gearList[i + 1] == guidePid and gearList[i + 3] == guideTile) then g := i;
      end
      if (g < 0) then g := 0;   // list is sorted nearest first
      if (gearList[g + 4] != elevation(dude_obj)) then info := "level " + (gearList[g + 4] + 1);
      else begin
         w := tile_distance(tile_num(dude_obj), gearList[g + 3]);
         if (w <= 1) then info := "here";
         else info := w + " hex";
      end
      tmp := "GEAR ";
      if (guidePid and gearList[g + 1] == guidePid) then tmp := "GEAR> ";
      call PanelAdd(tmp + obj_name(gearList[g]) + " (" + HolderText(gearList[g + 2]) + ")", info, COL_INFO, 0);
      infoArrow := -1;
      infoTgt := 0;
      if (gearList[g + 4] == elevation(dude_obj) and w > 1) then begin
         tmp := ScreenOffset(tile_num(dude_obj), gearList[g + 3]);
         infoArrow := ArrowFor(tmp[0], tmp[1]);
      end
      // only the gear you asked to be guided to gets a map marker
      if (guidePid and gearList[g + 1] == guidePid) then infoTgt := [gearList[g + 3], gearList[g + 4], 0];
      call PanelArrow;
   end
end

procedure SetCol(variable col) begin
   if (col == COL_HEAD) then SetTextColor(0.95, 0.85, 0.35);
   else if (col == COL_DONE) then SetTextColor(0.55, 0.6, 0.55);
   else if (col == COL_INFO) then SetTextColor(0.4, 0.9, 1.0);
   else if (col == COL_WARN) then SetTextColor(1.0, 0.35, 0.3);
   else if (col == COL_SEL) then SetTextColor(1.0, 1.0, 1.0);
   else if (col == COL_DIM) then SetTextColor(0.35, 0.6, 0.35);
   else SetTextColor(0.25, 1.0, 0.25);
end

procedure Text(variable txt, variable x, variable y, variable w, variable col) begin
   if (txt == "" or w <= 0) then return;
   call SetCol(col);
   Format(txt, x, y, w, lineH, 0);
end

procedure PanelWanted begin
   variable mode := get_game_mode;
   if (not panelOn or tabOpen or not loaded) then return false;
   if (mode == WORLDMAP) then return true;   // travel: where to go next
   if (mode bwand bwnot(COMBAT bwor PCOMBAT)) then return false;
   if (not panelInCombat and (mode bwand (COMBAT bwor PCOMBAT))) then return false;
   if (cur_map_index < 0) then return false;
   return true;
end

procedure HidePanel begin
   if (panelCreated and panelVisible) then hide_window(PANEL_WIN);
   panelVisible := false;
end

#define ARROW_SZ (13)
// split lines whose text is wider than the panel at a space; the last part keeps the
// distance / arrow, continuation lines are indented a little more
procedure WrapPanel begin
   variable out, i, n, words, w, cur, nxt, maxW, ind, k, o;
   SetFont(panelFont);
   n := len_array(panelLines);
   out := temp_array(0, 0);
   for (i := 0; i < n; i += 5) begin
      ind := panelLines[i + 3];
      maxW := panelW - 12 - ind;
      if (get_text_width(panelLines[i]) <= maxW) then begin
         o := len_array(out);
         resize_array(out, o + 5);
         for (k := 0; k < 5; k++) out[o + k] := panelLines[i + k];
      end else begin
         words := string_split(panelLines[i], " ");
         cur := "";
         foreach (w in words) begin
            if (cur == "") then nxt := w; else nxt := cur + " " + w;
            if (cur != "" and get_text_width(nxt) > maxW) then begin
               o := len_array(out);
               resize_array(out, o + 5);
               out[o] := cur; out[o + 1] := ""; out[o + 2] := panelLines[i + 2];
               out[o + 3] := ind; out[o + 4] := -1;
               cur := w;
               if (ind == panelLines[i + 3]) then begin ind += 10; maxW -= 10; end
            end else cur := nxt;
         end
         o := len_array(out);
         resize_array(out, o + 5);
         out[o] := cur; out[o + 1] := panelLines[i + 1]; out[o + 2] := panelLines[i + 2];
         out[o + 3] := ind; out[o + 4] := panelLines[i + 4];
      end
   end
   panelLines := out;
end

procedure DrawPanel begin
   variable i, n, y := 4, sig := "", x, txt, info, wl, wr, maxH, sw, sh, ar, aw;
   lineH := 12;
   if (panelFont == 100) then lineH := 10;
   call WrapPanel;
   n := len_array(panelLines);
   for (i := 0; i < n; i += 5) begin
      sig += panelLines[i] + "|" + panelLines[i + 1] + "|" + panelLines[i + 4] + "|";
   end
   sw := get_screen_width;
   sh := get_screen_height;
   maxH := sh - 110 - panelY;
   if (maxH < 100) then maxH := 100;
   if (not panelCreated) then begin
      if (panelExists) then DeleteWin(PANEL_WIN);
      x := panelX;
      if (x < 0) then x := sw - panelW - 4;
      create_win_flag(PANEL_WIN, x, panelY, panelW, maxH,
                      WIN_FLAG_MOVEONTOP bwor WIN_FLAG_TRANSPARENT bwor WIN_FLAG_HIDDEN);
      panelCreated := true;
      panelExists := true;
      panelVisible := false;
      panelSig := "";
   end
   if (sig != panelSig) then begin
      panelSig := sig;
      SelectWin(PANEL_WIN);
      sfall_func0("win_fill_color");
      SetFont(panelFont);
      SetTextFlags(0x2010000);   // shadow, no background fill
      // measure height
      y := 4;
      for (i := 0; i < n; i += 5) begin
         aw := 0;
         if (panelLines[i + 4] >= 0) then aw := ARROW_SZ + 3;
         wl := get_text_width(panelLines[i]) + panelLines[i + 3];
         wr := get_text_width(panelLines[i + 1]) + aw;
         if (wr > 0 and wl + wr + 10 > panelW - 8) then y += lineH;
         y += lineH;
      end
      panelH := y + 4;
      if (panelH > maxH) then panelH := maxH;
      if (panelBg and n > 0) then begin
         win_fill_color(0, 0, panelW, panelH, OBJ_COL_BG);
         win_fill_color(0, 0, 1, panelH, OBJ_COL_BORDER);
      end
      y := 4;
      for (i := 0; i < n; i += 5) begin
         if (y + lineH <= maxH) then begin
            txt := panelLines[i];
            info := panelLines[i + 1];
            ar := panelLines[i + 4];
            aw := 0;
            if (ar >= 0) then aw := ARROW_SZ + 3;
            call Text(txt, 6 + panelLines[i + 3], y, panelW - 12 - panelLines[i + 3], panelLines[i + 2]);
            if (info != "" or ar >= 0) then begin
               wl := get_text_width(txt) + panelLines[i + 3];
               wr := get_text_width(info);
               if (wl + wr + aw + 10 > panelW - 8) then y += lineH;
               if (y + lineH <= maxH) then begin
                  if (panelLines[i + 2] == COL_TEXT) then call Text(info, panelW - 6 - aw - wr, y, wr + 2, COL_INFO);
                  else call Text(info, panelW - 6 - aw - wr, y, wr + 2, panelLines[i + 2]);
                  if (ar >= 0) then
                     draw_image(ArrowFile(ar), 0, panelW - 6 - ARROW_SZ, y - 1, 0);
               end
            end
         end
         y += lineH;
      end
      ShowWin;
   end
   if (n == 0) then begin
      call HidePanel;
      return;
   end
   if (not panelVisible) then begin
      show_window(PANEL_WIN);
      panelVisible := true;
   end
end

/* ------------------------------------------------------------------ map markers */
// marks: 3 ints per target on this map: tile, elevation, object (0 = none)

procedure AddMark(variable tgt, variable dist) begin
   variable n, i;
   if (not marks) then return;
   n := len_array(marks);
   for (i := 0; i < n; i += 3) begin
      if (marks[i] == tgt[0] and marks[i + 1] == tgt[1]) then return;
   end
   resize_array(marks, n + 3);
   marks[n] := tgt[0];
   marks[n + 1] := tgt[1];
   marks[n + 2] := tgt[2];
end

procedure MarksWanted begin
   if (not loaded or tabOpen or not markEdge) then return false;
   if (get_game_mode != 0) then return false;   // not in combat or any menu
   return (cur_map_index >= 0);
end

procedure HideMarks begin
   variable i;
   if (not markWin) then return;
   for (i := 0; i < MARK_MAX; i++) begin
      if (markWin[i * 3]) then begin
         DeleteWin("obj_mk" + i);
         markWin[i * 3] := 0;
      end
   end
end

// an arrow with the distance at the screen edge for each target that is off screen
procedure UpdateMarks begin
   variable sw, sh, mapH, cx, cy, c, i, k := 0, n, t, off, tx, ty, ex, ey, d, a, key, nm, num, den, lim, used;
   if (not markWin) then return;
   if (not MarksWanted or not marks) then begin
      call HideMarks;
      return;
   end
   sw := get_screen_width;
   sh := get_screen_height;
   mapH := sh - BAR_H;
   cx := sw / 2;
   cy := mapH / 2;
   c := tile_by_position(cx, cy);
   used := temp_array(MARK_MAX, 0);
   n := len_array(marks);
   if (c >= 0) then begin
      for (i := 0; i < n and k < MARK_MAX; i += 3) begin
         t := marks[i];
         if (marks[i + 1] == elevation(dude_obj)) then begin
            off := ScreenOffset(c, t);
            tx := cx + off[0];
            ty := cy + off[1];
            if (tx < 0 or tx >= sw or ty < 0 or ty >= mapH) then begin
               // clamp the ray centre -> target to the screen edge
               ex := off[0];
               ey := off[1];
               num := 1000;
               if (ex > 0) then lim := (cx - MARK_W - 4) * 1000 / ex;
               else if (ex < 0) then lim := (cx - MARK_W - 4) * 1000 / (-ex);
               else lim := 1000;
               if (lim < num) then num := lim;
               if (ey > 0) then lim := (cy - MARK_H - 4) * 1000 / ey;
               else if (ey < 0) then lim := (cy - MARK_H - 4) * 1000 / (-ey);
               else lim := 1000;
               if (lim < num) then num := lim;
               ex := cx + ex * num / 1000 - MARK_W / 2;
               ey := cy + ey * num / 1000 - MARK_H / 2;
               // keep clear of the quest panel
               if (panelVisible and panelX < 0 and ex + MARK_W > sw - panelW - 4 and ey < panelY + panelH) then
                  ex := sw - panelW - 8 - MARK_W;
               d := tile_distance(tile_num(dude_obj), t);
               a := ArrowFor(off[0], off[1]);
               key := ex + "," + ey + "," + d + "," + a;
               nm := "obj_mk" + k;
               if (markWin[k * 3] and markWin[k * 3 + 1] != key) then begin
                  DeleteWin(nm);
                  markWin[k * 3] := 0;
               end
               if (not markWin[k * 3]) then begin
                  create_win_flag(nm, ex, ey, MARK_W, MARK_H, WIN_FLAG_MOVEONTOP bwor WIN_FLAG_TRANSPARENT);
                  SelectWin(nm);
                  win_fill_color(0, 0, MARK_W, MARK_H, OBJ_COL_BG);
                  win_fill_color(0, 0, MARK_W, 1, OBJ_COL_BORDER);
                  draw_image("art\\intrface\\OBJM" + a + ".FRM", 0, 2, 1, 0);
                  SetFont(101);
                  SetTextFlags(0x2010000);
                  call Text("" + d, 21, 4, MARK_W - 22, COL_INFO);
                  ShowWin;
                  markWin[k * 3] := 1;
                  markWin[k * 3 + 1] := key;
               end
               k += 1;
            end
         end
      end
   end
   for (i := k; i < MARK_MAX; i++) begin
      if (markWin[i * 3]) then begin
         DeleteWin("obj_mk" + i);
         markWin[i * 3] := 0;
      end
   end
end

/* --------------------------------------------------------------------- gear */

procedure CollectAmmo begin
   variable i := 0, it, cal, r;
   if (ammoCal) then free_array(ammoCal);
   ammoCal := create_array(-1, 0);
   it := inven_ptr(dude_obj, 0);
   while (it) do begin
      if (obj_item_subtype(it) == item_type_ammo) then begin
         cal := get_proto_data(obj_pid(it), PROTO_AM_CALIBER);
         r := get_proto_data(obj_pid(it), PROTO_AM_DMG_MULT) * 100;
         if (get_proto_data(obj_pid(it), PROTO_AM_DMG_DIV) > 0) then
            r := r / get_proto_data(obj_pid(it), PROTO_AM_DMG_DIV);
         if (r > ammoCal[cal]) then ammoCal[cal] := r;
      end
      i += 1;
      it := inven_ptr(dude_obj, i);
   end
end

// damage per AP x100 for the player; 0 = unusable
procedure WeaponScorePid(variable pid, variable loadedAmmo) begin
   variable flags, mode, avg, ap, skill, minSt, hit, dt, mult, score, burst, ap2, cal;
   flags := get_proto_data(pid, PROTO_IT_FLAGS);
   mode := flags bwand 0xF;
   if (mode == 0) then return 0;
   avg := (get_proto_data(pid, PROTO_WP_DMG_MIN) + get_proto_data(pid, PROTO_WP_DMG_MAX)) * 50;
   ap := get_proto_data(pid, PROTO_WP_APCOST_1);
   if (ap < 1) then ap := 1;
   minSt := get_proto_data(pid, PROTO_WP_MIN_ST);
   if (mode <= ATTACK_MODE_KICK) then begin
      skill := SKILL_UNARMED_COMBAT;
      avg += get_critter_stat(dude_obj, STAT_melee_dmg) * 100;
   end else if (mode <= ATTACK_MODE_THRUST) then begin
      skill := SKILL_MELEE;
      avg += get_critter_stat(dude_obj, STAT_melee_dmg) * 100;
   end else if (mode == ATTACK_MODE_THROW) then begin
      skill := SKILL_THROWING;
   end else begin
      dt := get_proto_data(pid, PROTO_WP_DMG_TYPE);
      if (flags bwand WEAPON_BIGGUN) then skill := SKILL_BIG_GUNS;
      else if ((flags bwand WEAPON_ENERGY) or dt == DMG_laser or dt == DMG_plasma or dt == DMG_electrical) then
         skill := SKILL_ENERGY_WEAPONS;
      else skill := SKILL_SMALL_GUNS;
      if (get_proto_data(pid, PROTO_WP_MAG_SIZE) > 0) then begin
         cal := get_proto_data(pid, PROTO_WP_CALIBER);
         mult := ammoCal[cal];
         if (mult == 0 and loadedAmmo > 0) then begin
            mult := get_proto_data(loadedAmmo, PROTO_AM_DMG_MULT) * 100;
            if (get_proto_data(loadedAmmo, PROTO_AM_DMG_DIV) > 0) then
               mult := mult / get_proto_data(loadedAmmo, PROTO_AM_DMG_DIV);
         end
         if (mult == 0) then return 0;   // no ammo for it
         avg := avg * mult / 100;
      end
   end
   hit := has_skill(dude_obj, skill);
   if (minSt > get_critter_stat(dude_obj, STAT_st)) then
      hit -= 20 * (minSt - get_critter_stat(dude_obj, STAT_st));
   if (hit < 5) then hit := 5;
   if (hit > 95) then hit := 95;
   score := avg * hit / 100 / ap;
   // burst as secondary mode: about a third of the rounds hit
   if (((flags / 16) bwand 0xF) == ATTACK_MODE_BURST) then begin
      burst := get_proto_data(pid, PROTO_WP_BURST);
      ap2 := get_proto_data(pid, PROTO_WP_APCOST_2);
      if (ap2 < 1) then ap2 := 1;
      if (burst > 1 and avg * hit / 100 * burst / 3 / ap2 > score) then
         score := avg * hit / 100 * burst / 3 / ap2;
   end
   if (score < 1) then score := 1;
   return score;
end

procedure ArmorScorePid(variable pid) begin
   return get_proto_data(pid, PROTO_AR_AC) + get_proto_data(pid, PROTO_AR_DR_NORMAL)
          + 2 * get_proto_data(pid, PROTO_AR_DT_NORMAL);
end

// [type 1 weapon / 2 armor, score] or 0
procedure ItemScore(variable item) begin
   variable st := obj_item_subtype(item), ammo := 0;
   if (st == item_type_weapon) then begin
      if (get_proto_data(obj_pid(item), PROTO_WP_MAG_SIZE) > 0 and get_weapon_ammo_count(item) > 0) then
         ammo := get_weapon_ammo_pid(item);
      return [1, WeaponScorePid(obj_pid(item), ammo)];
   end
   if (st == item_type_armor) then return [2, ArmorScorePid(obj_pid(item))];
   return 0;
end

procedure CurrentGear begin
   variable w, s;
   gearCurW := (150 + get_critter_stat(dude_obj, STAT_melee_dmg) * 100)
               * has_skill(dude_obj, SKILL_UNARMED_COMBAT) / 100 / 3;
   w := critter_inven_obj(dude_obj, INVEN_TYPE_RIGHT_HAND);
   if (w and obj_item_subtype(w) == item_type_weapon) then begin
      s := ItemScore(w);
      if (s[1] > gearCurW) then gearCurW := s[1];
   end
   w := critter_inven_obj(dude_obj, INVEN_TYPE_LEFT_HAND);
   if (w and obj_item_subtype(w) == item_type_weapon) then begin
      s := ItemScore(w);
      if (s[1] > gearCurW) then gearCurW := s[1];
   end
   gearCurA := 0;
   w := critter_inven_obj(dude_obj, INVEN_TYPE_WORN);
   if (w) then gearCurA := ArmorScorePid(obj_pid(w));
end

// gearList entries: item, pid, holder, tile, elev, distance
procedure AddGear(variable item, variable holder) begin
   variable sc := ItemScore(item), n, i, pos, d, src;
   if (not sc) then return;
   if (sc[0] == 1) then begin
      if (sc[1] * 100 <= gearCurW * (100 + gearMargin)) then return;
   end else begin
      if (sc[1] * 100 <= gearCurA * (100 + gearMargin) or sc[1] <= gearCurA) then return;
   end
   src := item;
   if (holder) then src := holder;
   d := tile_distance_objs(dude_obj, src);
   if (elevation(src) != elevation(dude_obj)) then d += 10000;
   // skip duplicates of the same pid in the same place
   n := len_array(gearList);
   for (i := 0; i < n; i += 6) begin
      if (gearList[i + 1] == obj_pid(item) and gearList[i + 3] == tile_num(src)) then return;
   end
   pos := n;
   for (i := 0; i < n; i += 6) begin
      if (pos == n and d < gearList[i + 5]) then pos := i;
   end
   resize_array(gearList, n + 6);
   for (i := n - 1; i >= pos; i--) begin
      gearList[i + 6] := gearList[i];
   end
   gearList[pos] := item;
   gearList[pos + 1] := obj_pid(item);
   gearList[pos + 2] := holder;
   gearList[pos + 3] := tile_num(src);
   gearList[pos + 4] := elevation(src);
   gearList[pos + 5] := d;
end

procedure ScanGear begin
   variable o, i, it;
   resize_array(gearList, 0);
   call CollectAmmo;
   call CurrentGear;
   foreach (o in list_as_array(LIST_GROUNDITEMS)) begin
      if (o) then begin
         if (obj_item_subtype(o) == item_type_container) then begin
            i := 0;
            it := inven_ptr(o, 0);
            while (it and i < 200) do begin
               call AddGear(it, o);
               i += 1;
               it := inven_ptr(o, i);
            end
         end else begin
            call AddGear(o, 0);
         end
      end
   end
   foreach (o in list_as_array(LIST_CRITTERS)) begin
      if (o and o != dude_obj and not obj_in_party(o)) then begin
         i := 0;
         it := inven_ptr(o, 0);
         while (it and i < 200) do begin
            call AddGear(it, o);
            i += 1;
            it := inven_ptr(o, i);
         end
      end
   end
end

procedure HolderText(variable holder) begin
   if (not holder) then return "ground";
   if (obj_type(holder) == OBJ_TYPE_CRITTER) then begin
      if (critter_state(holder) == CRITTER_IS_DEAD) then return "dead " + obj_name(holder);
      return "on " + obj_name(holder);
   end
   return "in " + obj_name(holder);
end

/* --------------------------------------------------------------- highlights */

// PIDs of items the current quest steps need
procedure QuestItemPids begin
   variable q, s, i, n, p;
   questPids := temp_array(-1, 0);
   for (q := 0; q < OBJ_NQ; q++) begin
      s := qCur[q];
      if (s >= 0) then s := GroupStart(s);
      while (s >= 0) do begin
         if (s_tkind[s] == T_ITEM) then begin
            for (i := 0; i < s_tn[s]; i++) questPids[i_pool[s_t0[s] + i]] := 1;
         end
         n := c_pool[s_done[s]];
         for (i := 0; i < n; i++) begin
            p := s_done[s] + 1 + i * 5;
            if (c_pool[p] == C_ITEM and c_pool[p + 3] != 1) then questPids[c_pool[p + 1]] := 1;
         end
         s += 1;
         if (s >= OBJ_NS) then s := -1;
         else if (not s_alt[s]) then s := -1;
      end
   end
end

// Outlines we set are remembered in 'owned' (object -> colour). We only ever clear those,
// so the built-in item highlighter (same yellow) keeps its own outlines, toggle or hold.
procedure ApplyHighlights begin
   variable o, want, cur, i, it, gearObjs, guideObj := 0, newOwned, tgtObjs, hasScen;
   gearObjs := temp_array(-1, 0);
   newOwned := create_array(-1, 0);
   for (i := 0; i < len_array(gearList); i += 6) begin
      if (gearList[i + 2]) then gearObjs[gearList[i + 2]] := 1;
      else gearObjs[gearList[i]] := 1;
      if (guidePid and gearList[i + 1] == guidePid and gearList[i + 3] == guideTile) then begin
         if (gearList[i + 2]) then guideObj := gearList[i + 2]; else guideObj := gearList[i];
      end
   end
   foreach (o in list_as_array(LIST_GROUNDITEMS)) begin
      if (o) then begin
         want := 0;
         if (hlOn) then begin
            if (obj_item_subtype(o) == item_type_container) then begin
               if (hlCont) then begin
                  if (hlGear and gearObjs[o]) then want := hlGearCol;
                  i := 0;
                  it := inven_ptr(o, 0);
                  while (it and i < 200) do begin
                     if (hlQuest and questPids[obj_pid(it)]) then want := hlQuestCol;
                     i += 1;
                     it := inven_ptr(o, i);
                  end
               end
            end else begin
               if (hlGear and gearObjs[o]) then want := hlGearCol;
               if (hlQuest and questPids[obj_pid(o)]) then want := hlQuestCol;
            end
            if (o == guideObj) then want := hlGearCol;
         end
         cur := get_outline(o);
         if (want) then begin
            if (cur != want) then set_outline(o, want);
            newOwned[o] := want;
         end else if (owned) then begin
            if (owned[o] and cur == owned[o]) then set_outline(o, 0);
         end
      end
   end
   // people and objects the current steps point at (not items: those are yellow already)
   tgtObjs := temp_array(-1, 0);
   hasScen := false;
   if (hlOn and markOutline and marks and not (get_game_mode bwand (COMBAT bwor PCOMBAT))) then begin
      for (i := 0; i < len_array(marks); i += 3) begin
         o := marks[i + 2];
         if (o) then begin
            if (obj_type(o) == OBJ_TYPE_CRITTER or obj_type(o) == OBJ_TYPE_SCENERY) then begin
               tgtObjs[o] := 1;
               if (obj_type(o) == OBJ_TYPE_SCENERY) then hasScen := true;
            end
         end
      end
   end
   foreach (o in list_as_array(LIST_CRITTERS)) begin
      if (o and o != dude_obj) then call OwnOutline(o, tgtObjs[o], newOwned);
   end
   if (hasScen or ownsScenery) then begin
      foreach (o in list_as_array(LIST_SCENERY)) begin
         if (o) then call OwnOutline(o, tgtObjs[o], newOwned);
      end
   end
   ownsScenery := hasScen;
   if (owned) then free_array(owned);
   owned := newOwned;
   tile_refresh_display;
end

procedure OwnOutline(variable o, variable want, variable newOwned) begin
   variable cur := get_outline(o);
   if (want) then begin
      if (critter_state(o) == CRITTER_IS_DEAD and obj_type(o) == OBJ_TYPE_CRITTER) then return;
      if (cur != markCol) then set_outline(o, markCol);
      newOwned[o] := markCol;
   end else if (owned) then begin
      if (owned[o] and cur == owned[o]) then set_outline(o, 0);
   end
end

procedure ClearHighlights begin
   variable o, cur;
   if (not owned) then return;
   foreach (o in list_as_array(LIST_GROUNDITEMS)) begin
      if (o and owned[o]) then begin
         cur := get_outline(o);
         if (cur == owned[o]) then set_outline(o, 0);
      end
   end
   foreach (o in list_as_array(LIST_CRITTERS)) begin
      if (o and owned[o]) then begin
         cur := get_outline(o);
         if (cur == owned[o]) then set_outline(o, 0);
      end
   end
   if (ownsScenery) then begin
      foreach (o in list_as_array(LIST_SCENERY)) begin
         if (o and owned[o]) then begin
            cur := get_outline(o);
            if (cur == owned[o]) then set_outline(o, 0);
         end
      end
      ownsScenery := false;
   end
   clear_array(owned);
   tile_refresh_display;
end

/* ------------------------------------------------------------------ refresh */

procedure Refresh begin
   variable wantPanel := PanelWanted;
   onWorld := (get_game_mode == WORLDMAP);
   call ComputeStatus;
   if (onWorld) then begin
      // no map objects out here: just the panel with directions to the next places
      if (marks) then clear_array(marks);
      call HideMarks;
      if (wantPanel) then begin
         call BuildPanel;
         call DrawPanel;
      end else call HidePanel;
      return;
   end
   call ScanGear;
   // the panel lines also collect the targets for outlines and edge arrows
   if (wantPanel or MarksWanted or (hlOn and markOutline and get_game_mode == 0)) then call BuildPanel;
   else if (marks) then clear_array(marks);
   if (hlOn) then begin
      call QuestItemPids;
      call ApplyHighlights;
   end
   if (wantPanel) then call DrawPanel;
   else call HidePanel;
   call UpdateMarks;
end

/* -------------------------------------------------------------- objectives tab */

procedure TabRow(variable txt, variable info, variable col, variable kind, variable ref) begin
   variable n := len_array(tabRows);
   resize_array(tabRows, n + 5);
   tabRows[n] := txt;
   tabRows[n + 1] := info;
   tabRows[n + 2] := col;
   tabRows[n + 3] := kind;   // 0 none, 1 quest, 2 step, 3 group toggle, 4 gear, 5 setting
   tabRows[n + 4] := ref;
end

#define NSET 25
procedure ColourName(variable c) begin
   if (c == 1) then return "glowing red";
   if (c == 2) then return "red";
   if (c == 4) then return "grey";
   if (c == 8) then return "glowing green";
   if (c == 16) then return "yellow";
   if (c == 32) then return "dark yellow";
   if (c == 64) then return "purple";
   return "" + c;
end
procedure SettingText(variable i) begin
   variable v;
   if (i == 0) then return ["Panel shown", panelOn];
   if (i == 1) then return ["Panel width (px)", panelW];
   if (i == 2) then return ["Optional quests in panel", optCount];
   if (i == 3) then return ["Steps per quest", stepCount];
   if (i == 4) then return ["Show last done step (X)", showDone];
   if (i == 5) then return ["Panel background", panelBg];
   if (i == 6) then return ["Hide panel under mouse", hideHover];
   if (i == 7) then return ["Panel font (100-103)", panelFont];
   if (i == 8) then return ["GEAR line in panel", showGear];
   if (i == 9) then return ["Water / invasion timer", showTimer];
   if (i == 10) then return ["Panel during combat", panelInCombat];
   if (i == 11) then return ["Highlights", hlOn];
   if (i == 12) then return ["Highlight quest items", hlQuest];
   if (i == 13) then return ["Highlight better gear", hlGear];
   if (i == 14) then return ["Highlight containers too", hlCont];
   if (i == 15) then return ["Quest item colour", hlQuestCol];
   if (i == 16) then return ["Gear colour", hlGearCol];
   if (i == 17) then return ["Better by at least (%)", gearMargin];
   if (i == 18) then return ["Objectives key (DX code)", tabKey];
   if (i == 19) then return ["Panel toggle key (0=none)", panelKey];
   if (i == 20) then return ["Panel X (-1 = right edge)", panelX];
   if (i == 21) then return ["Quests page: all quests as tree", questsAll];
   if (i == 22) then return ["Outline quest targets (people/objects)", markOutline];
   if (i == 23) then return ["Edge arrows for off-screen targets", markEdge];
   return ["Quest target colour", markCol];
end

procedure SettingChange(variable i, variable dir) begin
   variable v;
   if (i == 0) then begin panelOn := not panelOn; call SaveSetting("Panel", "Enabled", panelOn); end
   else if (i == 1) then begin
      panelW += 20 * dir;
      if (panelW < 160) then panelW := 160;
      if (panelW > 600) then panelW := 600;
      call SaveSetting("Panel", "Width", panelW);
      panelCreated := false;   // recreate with the new size
   end
   else if (i == 2) then begin
      optCount += dir; if (optCount < 0) then optCount := 0; if (optCount > 10) then optCount := 10;
      call SaveSetting("Panel", "OptionalQuests", optCount);
   end
   else if (i == 3) then begin
      stepCount += dir; if (stepCount < 1) then stepCount := 1; if (stepCount > 6) then stepCount := 6;
      call SaveSetting("Panel", "StepsPerQuest", stepCount);
   end
   else if (i == 4) then begin showDone := not showDone; call SaveSetting("Panel", "ShowDoneStep", showDone); end
   else if (i == 5) then begin panelBg := not panelBg; call SaveSetting("Panel", "Background", panelBg); end
   else if (i == 6) then begin hideHover := not hideHover; call SaveSetting("Panel", "HideOnHover", hideHover); end
   else if (i == 7) then begin
      panelFont += dir; if (panelFont < 100) then panelFont := 103; if (panelFont > 103) then panelFont := 100;
      lineH := 12; if (panelFont == 100) then lineH := 10;
      call SaveSetting("Panel", "Font", panelFont);
   end
   else if (i == 8) then begin showGear := not showGear; call SaveSetting("Panel", "ShowGear", showGear); end
   else if (i == 9) then begin showTimer := not showTimer; call SaveSetting("Panel", "ShowTimer", showTimer); end
   else if (i == 10) then begin panelInCombat := not panelInCombat; call SaveSetting("Panel", "ShowInCombat", panelInCombat); end
   else if (i == 11) then begin
      hlOn := not hlOn; call SaveSetting("Highlight", "Enabled", hlOn);
      if (not hlOn) then call ClearHighlights;
   end
   else if (i == 12) then begin hlQuest := not hlQuest; call SaveSetting("Highlight", "QuestItems", hlQuest); end
   else if (i == 13) then begin hlGear := not hlGear; call SaveSetting("Highlight", "BetterGear", hlGear); end
   else if (i == 14) then begin hlCont := not hlCont; call SaveSetting("Highlight", "Containers", hlCont); end
   else if (i == 15 or i == 16) then begin
      call ClearHighlights;
      if (i == 15) then v := hlQuestCol; else v := hlGearCol;
      if (dir > 0) then v := v * 2; else v := v / 2;
      if (v > 64) then v := 1;
      if (v < 1) then v := 64;
      if (i == 15) then begin hlQuestCol := v; call SaveSetting("Highlight", "QuestColor", v); end
      else begin hlGearCol := v; call SaveSetting("Highlight", "GearColor", v); end
   end
   else if (i == 17) then begin
      gearMargin += 5 * dir; if (gearMargin < 0) then gearMargin := 0; if (gearMargin > 100) then gearMargin := 100;
      call SaveSetting("Highlight", "BetterByPercent", gearMargin);
   end
   else if (i == 18) then keyCapture := 1;
   else if (i == 19) then keyCapture := 2;
   else if (i == 21) then begin questsAll := not questsAll; call SaveSetting("Tab", "AllQuests", questsAll); end
   else if (i == 22) then begin
      markOutline := not markOutline; call SaveSetting("Markers", "OutlineTargets", markOutline);
      if (not markOutline) then call ClearHighlights;
   end
   else if (i == 23) then begin
      markEdge := not markEdge; call SaveSetting("Markers", "EdgeArrows", markEdge);
      if (not markEdge) then call HideMarks;
   end
   else if (i == 24) then begin
      call ClearHighlights;
      if (dir > 0) then markCol := markCol * 2; else markCol := markCol / 2;
      if (markCol > 64) then markCol := 1;
      if (markCol < 1) then markCol := 64;
      call SaveSetting("Markers", "TargetColor", markCol);
   end
   else begin
      if (panelX < 0 and dir > 0) then panelX := 0;
      else panelX += 20 * dir;
      if (panelX < -1) then panelX := -1;
      call SaveSetting("Panel", "X", panelX);
      panelCreated := false;
   end
   panelSig := "";
end

procedure StatusLabel(variable q) begin
   variable st := qStatus[q];
   if (st == QS_ACTIVE) then return "active";
   if (st == QS_DONE) then return "done";
   if (st == QS_FAILED) then return "failed";
   if (st == QS_LOCKED) then return "locked";
   return "not started";
end

// one quest of the tree (its steps if active), then its children, depth first without recursion
procedure QuestRows(variable q, variable depth, variable section) begin
   variable stack, n, c, d, i, s, txt, col, pre, st, info, ind;
   stack := temp_array(0, 0);
   resize_array(stack, 2);
   stack[0] := q; stack[1] := depth;
   while (len_array(stack) > 0) do begin
      n := len_array(stack);
      q := stack[n - 2]; d := stack[n - 1];
      resize_array(stack, n - 2);
      st := qStatus[q];
      pre := "  ";
      for (i := 0; i < d; i++) pre += "   ";
      ind := pre;
      if (d > 0) then begin pre += "+ "; ind += "  "; end
      txt := q_name[q];
      // a child from another town or section says where it is
      if (d > 0 and not q_main[q] and (section < 0 or q_town[q] != section)) then txt := town_name[q_town[q]] + ": " + txt;
      if (q_key[q] == trackedKey) then txt := "* " + txt;
      if (st == QS_ACTIVE) then col := COL_HEAD;
      else if (st == QS_DONE) then col := COL_DONE;
      else if (st == QS_FAILED) then col := COL_WARN;
      else col := COL_DIM;
      info := StatusLabel(q);
      call TabRow(pre + txt, info, col, 1, q);
      if (st == QS_ACTIVE) then begin
         for (i := 0; i < q_sn[q]; i++) begin
            s := q_s0[q] + i;
            if (StepApplies(s)) then begin
               txt := s_text[s];
               if (s_alt[s]) then txt := "or: " + txt;
               if (StepDone(s)) then call TabRow(ind + "    X " + txt, "", COL_DONE, 2, s);
               else if (GroupDone(s)) then call TabRow(ind + "      " + txt, "not needed", COL_DIM, 2, s);
               else if (GroupStart(s) == GroupStart(qCur[q])) then call TabRow(ind + "    > " + txt, StepInfo(s), COL_SEL, 2, s);
               else call TabRow(ind + "      " + txt, StepInfo(s), COL_TEXT, 2, s);
            end
         end
      end else if (st == QS_INACTIVE and q_giver[q] != "") then begin
         call TabRow(ind + "    Start: " + q_giver[q], "", COL_DIM, 1, q);
      end else if (st == QS_LOCKED and q_lockhint[q] != "") then begin
         call TabRow(ind + "    Needs: " + q_lockhint[q], "", COL_DIM, 1, q);
      end
      // children in reverse so the first one comes out first
      for (c := OBJ_NQ - 1; c >= 0; c--) begin
         if (q_parent[c] == q) then begin
            n := len_array(stack);
            resize_array(stack, n + 2);
            stack[n] := c; stack[n + 1] := d + 1;
         end
      end
   end
end

procedure BuildTabRows begin
   variable q, s, i, t, st, any, nFin := 0, txt, info, col, g, d;
   resize_array(tabRows, 0);
   if (tabPage == PAGE_GEAR) then call ScanGear;   // never keep object pointers across frames
   if (tabPage == PAGE_QUESTS and questsAll) then begin
      // tree: each section lists its root quests; quests with a parent sit under the parent
      for (t := -2; t < OBJ_NTOWN; t++) begin
         any := false;
         for (q := 0; q < OBJ_NQ; q++) begin
            if (q_parent[q] < 0 and InSection(q, t) and not q_cut[q]) then begin
               if (not any) then begin
                  if (t == -2) then call TabRow("MAIN QUEST", WaterLine, COL_INFO, 0, 0);
                  else call TabRow(SectionName(t), "", COL_INFO, 0, 0);
                  any := true;
               end
               call QuestRows(q, 0, t);
            end
         end
      end
   end else if (tabPage == PAGE_QUESTS) then begin
      // main first (t = -1), then optional by town
      for (t := -2; t < OBJ_NTOWN; t++) begin
         any := false;
         for (q := 0; q < OBJ_NQ; q++) begin
            if (qStatus[q] == QS_ACTIVE and InSection(q, t)) then begin
               if (not any) then begin
                  if (t == -2) then call TabRow("MAIN QUEST", WaterLine, COL_INFO, 0, 0);
                  else call TabRow(SectionName(t), "", COL_INFO, 0, 0);
                  any := true;
               end
               txt := "  " + q_name[q];
               if (q_key[q] == trackedKey) then txt := "* " + q_name[q];
               call TabRow(txt, "", COL_HEAD, 1, q);
               for (i := 0; i < q_sn[q]; i++) begin
                  s := q_s0[q] + i;
                  if (StepApplies(s)) then begin
                     txt := s_text[s];
                     if (s_alt[s]) then txt := "or: " + txt;
                     if (StepDone(s)) then call TabRow("      X " + txt, "", COL_DONE, 2, s);
                     else if (GroupDone(s)) then call TabRow("        " + txt, "not needed", COL_DIM, 2, s);
                     else if (GroupStart(s) == GroupStart(qCur[q])) then call TabRow("      > " + txt, StepInfo(s), COL_SEL, 2, s);
                     else call TabRow("        " + txt, StepInfo(s), COL_TEXT, 2, s);
                  end
               end
            end
         end
      end
      for (q := 0; q < OBJ_NQ; q++) begin
         if (qStatus[q] == QS_DONE or qStatus[q] == QS_FAILED) then nFin += 1;
      end
      if (nFin > 0) then begin
         if (showFinished) then call TabRow("[-] FINISHED / FAILED (" + nFin + ")", "", COL_INFO, 3, 0);
         else call TabRow("[+] FINISHED / FAILED (" + nFin + ")", "", COL_INFO, 3, 0);
         if (showFinished) then begin
            for (q := 0; q < OBJ_NQ; q++) begin
               if (qStatus[q] == QS_DONE) then call TabRow("  " + q_name[q], town_name[q_town[q]] + "  done", COL_DONE, 1, q);
               else if (qStatus[q] == QS_FAILED) then call TabRow("  " + q_name[q], town_name[q_town[q]] + "  failed", COL_WARN, 1, q);
            end
         end
      end
      if (len_array(tabRows) == 0) then call TabRow("No active quests.", "", COL_DIM, 0, 0);
   end else if (tabPage == PAGE_GEAR) then begin
      call TabRow("Better than what you use (weapon " + gearCurW + ", armor " + gearCurA + "), nearest first",
                  "", COL_INFO, 0, 0);
      for (i := 0; i < len_array(gearList); i += 6) begin
         g := gearList[i];
         st := ItemScore(g);
         if (gearList[i + 4] != elevation(dude_obj)) then info := "level " + (gearList[i + 4] + 1);
         else info := gearList[i + 5] + " " + DirName(rotation_to_tile(tile_num(dude_obj), gearList[i + 3]));
         txt := "  " + obj_name(g);
         col := COL_TEXT;
         if (guidePid and gearList[i + 1] == guidePid and gearList[i + 3] == guideTile) then begin
            txt := "> " + obj_name(g);
            col := COL_SEL;
         end
         if (st[0] == 1) then txt += "  (score " + st[1] + ")";
         else txt += "  (armor " + st[1] + ")";
         call TabRow(txt + "  " + HolderText(gearList[i + 2]), info, col, 4, i);
      end
      if (len_array(gearList) == 0) then call TabRow("  Nothing better on this map.", "", COL_DIM, 0, 0);
   end else begin
      for (i := 0; i < NSET; i++) begin
         st := SettingText(i);
         txt := "" + st[1];
         if (i == 15 or i == 16 or i == 24) then txt := ColourName(st[1]);
         else if (i == 1 or i == 2 or i == 3 or i == 7 or i == 17 or i == 18 or i == 19 or i == 20) then txt := "" + st[1];
         else if (st[1]) then txt := "on"; else txt := "off";
         if ((i == 18 and keyCapture == 1) or (i == 19 and keyCapture == 2)) then txt := "press a key...";
         call TabRow("  " + st[0], txt, COL_TEXT, 5, i);
      end
   end
   if (tabSel >= len_array(tabRows) / 5) then tabSel := len_array(tabRows) / 5 - 1;
   if (tabSel < 0) then tabSel := 0;
end

procedure OpenTab begin
   variable sw := get_screen_width, sh := get_screen_height;
   tabW := sw - 80;
   if (tabW > 960) then tabW := 960;
   tabH := sh - 160;
   if (tabH > 600) then tabH := 600;
   if (tabH < 300) then tabH := 300;
   tabX := (sw - tabW) / 2;
   tabY := (sh - 100 - tabH) / 2;
   if (tabY < 0) then tabY := 0;
   call HideMarks;
   create_win_flag(TAB_WIN, tabX, tabY, tabW, tabH, WIN_FLAG_MOVEONTOP bwor WIN_FLAG_EXCLUSIVE);
   tabCreated := true;
   tabOpen := true;
   onWorld := false;
   keyCapture := 0;
   call HidePanel;
   call ComputeStatus;
   call ScanGear;
   call BuildTabRows;
   call DrawTab;
end

procedure CloseTab begin
   if (tabCreated) then DeleteWin(TAB_WIN);
   tabCreated := false;
   tabOpen := false;
   keyCapture := 0;
   panelSig := "";
   call Refresh;
end

#define TAB_HEAD_H   (30)
#define TAB_FOOT_H   (40)
procedure DrawTab begin
   variable i, y, n, vis, wr, txt, col, x, q, s, note := "";
   if (not tabCreated) then return;
   SelectWin(TAB_WIN);
   win_fill_color(0, 0, tabW, tabH, OBJ_COL_BG);
   win_fill_color(0, 0, tabW, 1, OBJ_COL_BORDER);
   win_fill_color(0, tabH - 1, tabW, 1, OBJ_COL_BORDER);
   win_fill_color(0, 0, 1, tabH, OBJ_COL_BORDER);
   win_fill_color(tabW - 1, 0, 1, tabH, OBJ_COL_BORDER);
   SetFont(101);
   SetTextFlags(0x2000000);
   lineH := 12;
   // header tabs
   x := 12;
   for (i := 0; i < 3; i++) begin
      if (i == 0) then txt := "1 QUESTS";
      else if (i == 1) then txt := "2 GEAR";
      else txt := "3 SETTINGS";
      if (i == tabPage) then begin
         win_fill_color(x - 4, 6, get_text_width(txt) + 8, 16, OBJ_COL_SEL);
         call Text(txt, x, 9, 200, COL_SEL);
      end else call Text(txt, x, 9, 200, COL_DIM);
      x += 110;
   end
   call Text("OBJECTIVES", tabW - 12 - get_text_width("OBJECTIVES"), 9, 200, COL_HEAD);
   win_fill_color(6, TAB_HEAD_H - 2, tabW - 12, 1, OBJ_COL_BORDER);
   // rows
   n := len_array(tabRows) / 5;
   vis := (tabH - TAB_HEAD_H - TAB_FOOT_H) / lineH;
   if (tabSel < tabTop) then tabTop := tabSel;
   if (tabSel >= tabTop + vis) then tabTop := tabSel - vis + 1;
   if (tabTop < 0) then tabTop := 0;
   y := TAB_HEAD_H + 2;
   for (i := tabTop; i < n and i < tabTop + vis; i++) begin
      col := tabRows[i * 5 + 2];
      if (i == tabSel) then win_fill_color(4, y - 1, tabW - 8, lineH, OBJ_COL_SEL);
      call Text(tabRows[i * 5], 10, y, tabW - 20, col);
      txt := tabRows[i * 5 + 1];
      if (txt != "") then begin
         wr := get_text_width(txt);
         call Text(txt, tabW - 12 - wr, y, wr + 2, COL_INFO);
      end
      y += lineH;
   end
   if (tabTop > 0) then call Text("^ more", tabW - 180, 9, 50, COL_DIM);
   if (tabTop + vis < n) then call Text("v more", tabW - 60, tabH - TAB_FOOT_H, 50, COL_DIM);
   // footer: note of the selected row + key help
   win_fill_color(6, tabH - TAB_FOOT_H + 12, tabW - 12, 1, OBJ_COL_BORDER);
   if (n > 0) then begin
      i := tabRows[tabSel * 5 + 3];
      if (i == 1) then begin
         q := tabRows[tabSel * 5 + 4];
         note := q_desc[q];
         if (qStatus[q] == QS_LOCKED and q_lockhint[q] != "") then note := "Locked - needs: " + q_lockhint[q];
         else if (qStatus[q] == QS_INACTIVE and q_giver[q] != "") then note := "Not started - get it from: " + q_giver[q];
         if (note == "") then note := town_name[q_town[q]];
      end else if (i == 2) then begin
         s := tabRows[tabSel * 5 + 4];
         note := s_note[s];
         if (note == "" and s_label[s] != "") then note := "Where: " + s_label[s];
      end
   end
   call Text(note, 10, tabH - TAB_FOOT_H + 15, tabW - 20, COL_TEXT);
   if (tabPage == PAGE_QUESTS) then txt := "Up/Down select   Enter/T track quest   1-3 or Tab pages   O/Esc close";
   else if (tabPage == PAGE_GEAR) then txt := "Up/Down select   Enter guide the panel and outline to it   O/Esc close";
   else txt := "Up/Down select   Left/Right/Enter change (saved at once)   O/Esc close";
   call Text(txt, 10, tabH - 16, tabW - 20, COL_DIM);
   ShowWin;
end

procedure TabActivate(variable row) begin
   variable kind, ref, q;
   if (row < 0 or row >= len_array(tabRows) / 5) then return;
   kind := tabRows[row * 5 + 3];
   ref := tabRows[row * 5 + 4];
   if (kind == 1 or kind == 2) then begin
      if (kind == 2) then begin
         // find the quest of this step
         for (q := 0; q < OBJ_NQ; q++) begin
            if (ref >= q_s0[q] and ref < q_s0[q] + q_sn[q]) then ref := q;
         end
         if (ref >= OBJ_NQ) then return;
      end
      if (q_main[ref]) then return;
      if (trackedKey == q_key[ref]) then trackedKey := 0;
      else trackedKey := q_key[ref];
      set_sfall_global("OBJTRACK", trackedKey);
   end else if (kind == 3) then begin
      showFinished := not showFinished;
   end else if (kind == 4) then begin
      if (guidePid == gearList[ref + 1] and guideTile == gearList[ref + 3]) then begin
         guidePid := 0;
         guideTile := 0;
      end else begin
         guidePid := gearList[ref + 1];
         guideTile := gearList[ref + 3];
      end
   end else if (kind == 5) then begin
      call SettingChange(ref, 1);
   end
end

procedure TabKeyPress(variable key) begin
   variable n := len_array(tabRows) / 5, kind;
   if (key == DIK_UP) then tabSel -= 1;
   else if (key == DIK_DOWN) then tabSel += 1;
   else if (key == DIK_PRIOR) then tabSel -= 20;
   else if (key == DIK_NEXT) then tabSel += 20;
   else if (key == DIK_HOME) then tabSel := 0;
   else if (key == DIK_END) then tabSel := n - 1;
   else if (key == DIK_1) then begin tabPage := PAGE_QUESTS; tabSel := 0; tabTop := 0; end
   else if (key == DIK_2) then begin tabPage := PAGE_GEAR; tabSel := 0; tabTop := 0; end
   else if (key == DIK_3) then begin tabPage := PAGE_SETTINGS; tabSel := 0; tabTop := 0; end
   else if (key == DIK_TAB) then begin tabPage := (tabPage + 1) % 3; tabSel := 0; tabTop := 0; end
   else if (key == DIK_RETURN or key == DIK_T or key == DIK_SPACE) then call TabActivate(tabSel);
   else if ((key == DIK_LEFT or key == DIK_RIGHT) and tabPage == PAGE_SETTINGS and n > 0) then begin
      kind := tabRows[tabSel * 5 + 3];
      if (kind == 5) then begin
         if (key == DIK_LEFT) then call SettingChange(tabRows[tabSel * 5 + 4], -1);
         else call SettingChange(tabRows[tabSel * 5 + 4], 1);
      end
   end
   if (tabSel >= n) then tabSel := n - 1;
   if (tabSel < 0) then tabSel := 0;
   call BuildTabRows;
   call DrawTab;
end

/* -------------------------------------------------------------------- hooks */

procedure KeyHandler begin
   variable pressed := get_sfall_arg, key := get_sfall_arg, mode;
   if (not loaded) then return;
   // the built-in highlighter clears every outline when it switches off; redo ours next frame
   if (key == hlKey) then hlDirty := true;
   if (tabOpen) then begin
      if (pressed) then begin
         if (keyCapture) then begin
            if (key != DIK_ESCAPE) then begin
               if (keyCapture == 1) then begin tabKey := key; call SaveSetting("Keys", "Objectives", key); end
               else begin panelKey := key; call SaveSetting("Keys", "TogglePanel", key); end
            end
            keyCapture := 0;
            call BuildTabRows;
            call DrawTab;
         end else if (key == tabKey or key == DIK_ESCAPE) then begin
            call CloseTab;
         end else begin
            call TabKeyPress(key);
         end
      end
      set_sfall_return(255);   // swallow the key (pressed and released)
      return;
   end
   if (pressed) then begin
      mode := get_game_mode;
      if (key == tabKey and tabKey > 0 and mode == 0) then begin
         call OpenTab;
         set_sfall_return(255);
      end else if (key == panelKey and panelKey > 0 and (mode bwand bwnot(COMBAT bwor PCOMBAT)) == 0) then begin
         panelOn := not panelOn;
         call SaveSetting("Panel", "Enabled", panelOn);
         panelSig := "";
         call Refresh;
      end
   end
end

procedure MouseHandler begin
   variable pressed := get_sfall_arg, button := get_sfall_arg, mx, my, row, i;
   if (not tabOpen or not pressed or button != 0) then return;
   mx := get_mouse_x - tabX;
   my := get_mouse_y - tabY;
   if (mx < 0 or my < 0 or mx >= tabW or my >= tabH) then return;
   if (my < TAB_HEAD_H) then begin
      i := (mx - 8) / 110;
      if (i >= 0 and i <= 2 and i != tabPage) then begin
         tabPage := i; tabSel := 0; tabTop := 0;
      end
   end else if (my < tabH - TAB_FOOT_H) then begin
      row := tabTop + (my - TAB_HEAD_H - 2) / lineH;
      if (row >= 0 and row < len_array(tabRows) / 5) then begin
         if (row == tabSel) then call TabActivate(row);
         tabSel := row;
      end
   end
   call BuildTabRows;
   call DrawTab;
end

procedure GameModeHandler begin
   variable mode := get_game_mode;
   if (not loaded) then return;
   if (tabOpen and mode != 0) then call CloseTab;
   if (not MarksWanted) then call HideMarks;
   if (not PanelWanted) then call HidePanel;
   else panelSig := "";
end

procedure InvMoveHandler begin
   // picking an item up (type 7): drop our outline
   variable t := get_sfall_arg, it := get_sfall_arg;
   if (t == 7 and it and owned) then begin
      if (owned[it] and get_outline(it) == owned[it]) then set_outline(it, 0);
   end
end

procedure MapEnterHandler begin
   if (tabOpen) then call CloseTab;
   resize_array(gearList, 0);
   if (owned) then clear_array(owned);   // objects of the old map are gone
   ownsScenery := false;
   if (marks) then clear_array(marks);
   call HideMarks;
   guidePid := 0;
   guideTile := 0;
   panelSig := "";
end

procedure map_enter_p_proc begin
   call MapEnterHandler;
end

procedure start begin
   variable mx, my, over;
   if (game_loaded) then begin
      if (sfall_ver_major < 4) then return;
      call LoadSettings;
      call ObjData_Load;
      qStatus := create_array(OBJ_NQ, 0);
      qCur := create_array(OBJ_NQ, 0);
      mvarMem := load_array("obj_mvar");
      if (mvarMem == 0) then begin
         mvarMem := create_array(-1, 0);
         save_array("obj_mvar", mvarMem);
      end
      trackedKey := get_sfall_global_int("OBJTRACK");
      doneMem := load_array("obj_done");
      if (doneMem == 0) then begin
         doneMem := create_array(-1, 0);
         save_array("obj_done", doneMem);
      end
      gearList := create_array(0, 0);
      tabRows := create_array(0, 0);
      ammoCal := 0;
      owned := 0;
      ownsScenery := false;
      marks := create_array(0, 0);
      markWin := create_array(MARK_MAX * 3, 0);
      panelExists := false;
      panelCreated := false;
      tabCreated := false;
      tabOpen := false;
      panelSig := "";
      loaded := true;
      register_hook_proc(HOOK_KEYPRESS, KeyHandler);
      register_hook_proc(HOOK_MOUSECLICK, MouseHandler);
      register_hook_proc(HOOK_GAMEMODECHANGE, GameModeHandler);
      register_hook_proc(HOOK_INVENTORYMOVE, InvMoveHandler);
      set_global_script_type(1);
      set_global_script_repeat(1);
      frame := 0;
      return;
   end
   if (not loaded) then return;
   if (tabOpen) then begin
      if (get_game_mode != 0) then call CloseTab;
      return;
   end
   frame += 1;
   // edge arrows follow the screen while you scroll
   if (frame % 3 == 0) then call UpdateMarks;
   if (hlDirty and hlOn and get_game_mode == 0) then begin
      hlDirty := false;
      call QuestItemPids;
      call ApplyHighlights;
   end
   if (not PanelWanted) then begin
      call HidePanel;
      if (frame % (refreshFrames * 4) == 0 and hlOn and get_game_mode == 0) then call Refresh;
      return;
   end
   // hide under the mouse so the map stays clickable there
   if (hideHover and panelCreated and panelX < 0) then begin
      mx := get_mouse_x;
      my := get_mouse_y;
      over := (mx >= get_screen_width - panelW - 4 and my >= panelY and my < panelY + panelH);
      if (over) then begin
         call HidePanel;
         return;
      end
   end else if (hideHover and panelCreated) then begin
      mx := get_mouse_x;
      my := get_mouse_y;
      if (mx >= panelX and mx < panelX + panelW and my >= panelY and my < panelY + panelH) then begin
         call HidePanel;
         return;
      end
   end
   if (frame % refreshFrames == 0 or not panelVisible) then call Refresh;
end
