/*
   Fallout 1in2 Objectives  -  quest panel, highlights and Objectives tab

   sfall global script (sfall 4.5). Compile with tools/build.sh (sslc -s -l -q).
   Quest data comes from build/objectives_data.h, generated by tools/build_data.py.
   Settings: mods\fo1_objectives\objectives.ini
*/

#include "sfall.h"
#include "define_lite.h"
#include "define_extra.h"
#include "dik.h"
#include "objectives_data.h"


#define PANEL_WIN       "obj_panel"
#define TAB_WIN         "obj_tab"
#define MARK_MAX        3
#define MARK_W          (56)
#define MARK_H          (20)
#define BAR_H           (100)   // interface bar at the bottom of the screen
#define TICKS_PER_DAY   (864000)

// condition atoms (see tools/objdata.py)
#define C_OR    0
#define C_GVAR  1
#define C_ITEM  2
#define C_MAP   3
#define C_MVAR  4
#define C_TRUE  5
#define C_FALSE 6
#define C_TOWN  7
#define C_PARTY 8
// target kinds
#define T_NONE    0
#define T_NPC     1
#define T_CRITTER 2
#define T_ITEM    3
#define T_SCENERY 4
#define T_TILE    5
// quest status
#define QS_INACTIVE 0
#define QS_ACTIVE   1
#define QS_DONE     2
#define QS_FAILED   3
#define QS_LOCKED   4   // not obtainable yet (unlock condition false)
// line colours
#define COL_TEXT   0
#define COL_HEAD   1
#define COL_DONE   2
#define COL_INFO   3
#define COL_WARN   4
#define COL_SEL    5
#define COL_DIM    6
// tab pages
#define PAGE_QUESTS   0
#define PAGE_GEAR     1
#define PAGE_SETTINGS 2

